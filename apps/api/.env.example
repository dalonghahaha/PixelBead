# PixelBead API 环境变量样例
APP_ENV=development
LOG_LEVEL=INFO

# PostgreSQL
DATABASE_URL=postgresql+psycopg://pixelbead:pixelbead_dev_pwd@localhost:5432/pixelbead

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT (生产请用 openssl rand -hex 32)
JWT_SECRET=dev_secret_change_me_in_production_12345678
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

# CORS
CORS_ORIGINS=http://localhost:3000

# 存储
STORAGE_DIR=./storage
MAX_UPLOAD_MB=10
